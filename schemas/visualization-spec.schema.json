{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AlgoViz Visualization Specification v1",
  "type": "object",
  "required": ["version", "layout", "views"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "layout": { "enum": ["row", "column"] },
    "views": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "source"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "enum": ["graph", "array", "custom"] },
          "renderer": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "source": { "$ref": "#/$defs/pointer" },
          "item": {
            "type": "object",
            "required": ["label", "value"],
            "additionalProperties": false,
            "properties": {
              "label": { "$ref": "#/$defs/pointer" },
              "value": { "$ref": "#/$defs/pointer" },
              "nullLabel": { "type": "string", "minLength": 1 }
            }
          }
        },
        "allOf": [
          {
            "if": { "required": ["item"] },
            "then": { "properties": { "type": { "const": "array" } } }
          },
          {
            "if": { "properties": { "type": { "const": "custom" } } },
            "then": { "required": ["renderer"] },
            "else": { "not": { "required": ["renderer"] } }
          }
        ]
      }
    }
  },
  "$defs": {
    "pointer": {
      "type": "string",
      "anyOf": [
        { "const": "" },
        { "pattern": "^/(?:[^~]|~[01])*$" }
      ]
    }
  }
}
