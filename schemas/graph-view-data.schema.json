{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AlgoViz Graph View Data v1",
  "type": "object",
  "required": ["nodes", "edges"],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "target"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "label": {
            "description": "Optional edge label. The inspector displays text and numbers, and preserves other values as trace metadata.",
            "examples": ["shortcut", 5]
          }
        }
      }
    }
  }
}
